{
  "redirects": [
    { "source": "/portfolio", "destination": "/", "permanent": true },
    { "source": "/portfolio/:path*", "destination": "/", "permanent": true },
    { "source": "/resume", "destination": "/", "permanent": true },
    { "source": "/valima", "destination": "/wedding/valima", "permanent": false }
  ],
  "rewrites": [
    { "source": "/wedding", "destination": "https://WEDDING-PRODUCTION-ALIAS.vercel.app/wedding" },
    { "source": "/wedding/:path*", "destination": "https://WEDDING-PRODUCTION-ALIAS.vercel.app/wedding/:path*" }
  ]
}
